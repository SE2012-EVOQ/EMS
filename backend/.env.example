# Copy to backend/.env and set your own local MySQL credentials.
export DB_USERNAME="root"
export DB_PASSWORD="your-local-mysql-password"

# Blank local installation: create the first administrator in the browser.
export SPRING_PROFILES_ACTIVE="local"

# Opt in to demo seeding by switching the profile above to dev. Never use dev in production.
export DEV_DEMO_PASSWORD="EvoqDemo2026!"
